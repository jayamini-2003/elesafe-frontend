{
  "expo": {
    "name": "EleSafeLankaApp",
    "slug": "EleSafeLankaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "elesafelankaapp",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EleSafe Lanka to use your location to show nearby elephant sightings."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take photos for reports.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-router"
    ]
  }
}
