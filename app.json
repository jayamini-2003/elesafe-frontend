{
  "expo": {
    "name": "EleSafeLankaApp",
    "slug": "EleSafeLankaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "elesafelankaapp",

    "icon": "./assets/images/icon.png",

    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#E6F4FE"
      }
    },

    "web": {
      "favicon": "./assets/images/favicon.png"
    },

    /*"plugins": [
      "expo-router",
      "expo-splash-screen"
    ]*/


    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EleSafe Lanka to use your location to show nearby elephant sightings."
        }
      ]
    ],
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "ios": {
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
      }
    }
  }
}